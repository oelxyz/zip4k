---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { id } from '../../../data/id';
import { blogCopy } from '../../../data/blog';
import { SITE_URL } from '../../../data/site';
import { getPublishedPosts, postSlug } from '../../../lib/blog';

const copy = blogCopy.id;
const posts = await getPublishedPosts('id');

const alternates = [
  { hreflang: 'en', href: new URL('/blog/', SITE_URL).href },
  { hreflang: 'id', href: new URL('/id/blog/', SITE_URL).href },
  { hreflang: 'x-default', href: new URL('/blog/', SITE_URL).href },
];

const seo = {
  title: copy.seoTitle,
  description: copy.seoDescription,
  ogTitle: copy.seoTitle,
  ogDescription: copy.seoDescription,
  ogLocale: id.seo.ogLocale,
  ogLocaleAlternate: id.seo.ogLocaleAlternate,
  browserRequirements: id.seo.browserRequirements,
};
---

<BaseLayout
  lang="id"
  path="/id/blog/"
  seo={seo}
  masthead={id.masthead}
  footer={id.footer}
  skipLabel={copy.skipLabel}
  alternates={alternates}
  noindex={posts.length === 0}
>
  <section class="section shell" aria-labelledby="blog-title">
    <div class="section-head">
      <p class="section-no">{copy.sectionNo}</p>
      <h1 id="blog-title">{copy.title}</h1>
    </div>

    {
      posts.length === 0 ? (
        <p class="prose">{copy.empty}</p>
      ) : (
        <ul class="post-list">
          {posts.map((post) => (
            <li>
              <a class="post-link" href={`/id/blog/${postSlug(post)}/`}>
                <div class="post-summary">
                  <h2>{post.data.title}</h2>
                  <p>{post.data.description}</p>
                </div>
                <div class="post-aside">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {post.data.pubDate.toISOString().slice(0, 10)}
                  </time>
                  <span class="post-more">{copy.readMore} →</span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      )
    }

    <p class="post-back"><a href="/id/">{copy.backToTool}</a></p>
  </section>
</BaseLayout>
